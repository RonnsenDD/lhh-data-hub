# Nicht aktiviert. Erst nach expliziter Freigabe und Lizenzprüfung in .yml umbenennen.
name: Public Pegel Daten
on:
  workflow_dispatch:
  schedule:
    - cron: "*/15 * * * *" # UTC; GitHub kann Schedule-Ausführungen verzögern.
concurrency:
  group: lhh-data-hub-pegel
  cancel-in-progress: false
permissions:
  contents: write
jobs:
  update:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: "3.12"
      - name: Pegeldaten abrufen und validieren
        run: python src/pegel_fetch.py --output-dir data/generated
      - name: JSON-Dateien versionieren
        run: |
          git add -f data/generated/pegel-lauchhammer.json data/generated/pegel-biehlen-1.json
          if git diff --cached --quiet; then exit 0; fi
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git commit -m "Aktualisiere öffentliche Pegeldaten"
          git push
      - name: Technische Fehler und ausgebliebene Abrufe melden
        if: always()
        run: |
          python - <<'PY'
          import json
          from datetime import datetime, timezone
          from pathlib import Path
          bad = []
          now = datetime.now(timezone.utc)
          for path in (Path("data/generated/pegel-lauchhammer.json"), Path("data/generated/pegel-biehlen-1.json")):
              if not path.exists():
                  bad.append(f"{path}: fehlt")
                  continue
              data = json.loads(path.read_text(encoding="utf-8"))
              # stale is an expected successful source response, not a job failure.
              # Only a technical fetch/processing error fails this run.
              if data.get("status") not in ("ok", "stale"):
                  bad.append(f"{path}: status={data.get('status')}")
              attempt = data.get("lastAttemptAt")
              try:
                  attempted_at = datetime.fromisoformat(attempt.replace("Z", "+00:00"))
                  if (now - attempted_at).total_seconds() > 600:
                      bad.append(f"{path}: lastAttemptAt older than 10 minutes")
              except (AttributeError, TypeError, ValueError):
                  bad.append(f"{path}: lastAttemptAt missing/invalid")
          if bad:
              raise SystemExit("; ".join(bad))
          print("Pegelabrufe technisch erfolgreich; stale values remain explicitly marked stale.")
          PY
